    <Content Include="XML Data\Districts\127.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\128.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\152.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\320.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\500.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\501.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\505.xml" CopyToOutputDirectory="PreserveNewest" />

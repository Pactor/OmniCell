<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 is the engine start-engines.bat runs by default; net10.0 is the move to .NET 10. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <AssemblyName>ZoneEngine</AssemblyName>
    <RootNamespace>ZoneEngine</RootNamespace>
    <ApplicationIcon>zone.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: every project has its own Properties\AssemblyInfo.cs,
         outputs go exactly where they did, and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>Full</DebugType>
    <Optimize>False</Optimize>
    <OutputPath>..\..\Built\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\Built\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- The net10.0 engine goes into its own subfolder, so it cannot replace the net48 one;
       "start-engines.bat net10" runs it. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OutputPath>..\..\Built\$(Configuration)\net10.0\</OutputPath>
  </PropertyGroup>

  <!-- .NET Framework only: MEF comes with OmniCell.Core's package on .NET 10, the rest is part of
       .NET 10. Microsoft.VisualBasic was referenced but never used. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="NLog" Version="2.1.0" />
    <PackageReference Include="NLog.Config" Version="2.1.0" />
  </ItemGroup>

  <!-- The script compiler uses CodeDom on .NET Framework and Roslyn on .NET 10, where CodeDom's
       C# compiler does not exist. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Source\AOtomation.Messaging\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Cell.Core\Cell.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Communication\OmniCell.Communication.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Core\OmniCell.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Database\OmniCell.Database.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Enums\OmniCell.Enums.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Interfaces\OmniCell.Interfaces.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.ObjectManager\OmniCell.ObjectManager.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Stats\OmniCell.Stats.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Exceptions\OmniCell.Exceptions.csproj" />
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <ProjectReference Include="..\..\Libraries\Source\PlayfieldLoader\PlayfieldLoader.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Translations\Translations.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Utility\Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Component\ClientFactory.cs" />
    <Compile Remove="Core\InternalMessageHandler\ChatTextMessageHandler.cs" />
    <Compile Remove="Core\InternalMessageHandler\DespawnMessageHandler.cs" />
    <Compile Remove="Core\InternalMessages\Bulk.cs" />
    <Compile Remove="Scripts\InfoBot.cs" />
    <Compile Remove="Scripts\KnuBotFlappy.cs" />
    <Compile Include="..\..\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
    <!-- Compiled into ZoneEngine and also copied to Scripts, where the script compiler loads it. -->
    <Compile Update="Scripts\KnuBotItemGiver.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Listed so the build uses it as the base of ZoneEngine.exe.config. -->
    <None Include="App.config" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\KnuBotFlappy.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Scripts\InfoBot.cs" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\Config\Config.xml" Link="Config.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Scripts\dummy.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Levels.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\CombatWeapons.xml" CopyToOutputDirectory="PreserveNewest" />

    <Content Include="XML Data\Districts\103.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\105.xml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="XML Data\Districts\107.xml" CopyToOutputDirectory="PreserveNewest" />

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <!-- Assembly binding redirects are generated into <exe>.exe.config at build time by
       AutoGenerateBindingRedirects. MySqlConnector's dependency closure (System.Memory,
       System.Runtime.CompilerServices.Unsafe, ...) ships newer assembly versions than
       the references baked into those packages, so .NET Framework needs the redirects
       to load them. -->
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>LoginEngine</AssemblyName>
    <RootNamespace>LoginEngine</RootNamespace>
    <ApplicationIcon>login.ico</ApplicationIcon>
    <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>False</AllowUnsafeBlocks>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: every project has its own Properties\AssemblyInfo.cs,
         outputs go exactly where they did, and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>Full</DebugType>
    <Optimize>False</Optimize>
    <OutputPath>..\..\Built\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\Built\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Source\AOtomation.Messaging\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Cell.Core\Cell.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Core\OmniCell.Core.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\OmniCell.Database\OmniCell.Database.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Translations\Translations.csproj" />
    <ProjectReference Include="..\..\Libraries\Source\Utility\Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Config\Config.xml" Link="Config.xml" CopyToOutputDirectory="PreserveNewest" />
    <!-- This server's own settings, once configure-server.bat has written them. Copied by the build so a
         new or emptied Built folder does not fall back to Config.xml's placeholders. Ignored by git. -->
    <None Include="..\..\Config\Config.local.xml" Link="Config.local.xml" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\Config\Config.local.xml')" />
    <!-- Area names for the character list (PlayfieldNames). The file belongs to ZoneEngine. -->
    <Content Include="..\ZoneEngine\XML Data\Playfields.xml" Link="XML Data\Playfields.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

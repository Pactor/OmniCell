<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SmokeLounge.AOtomation.Messaging.Tests</AssemblyName>
    <RootNamespace>SmokeLounge.AOtomation.Messaging.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\SmokeLounge.snk</AssemblyOriginatorKeyFile>
    <!-- The project has its own Properties\AssemblyInfo.cs. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CommonAssemblyInfo.cs" Link="Properties\CommonAssemblyInfo.cs" />
  </ItemGroup>

  <!-- The captured packets the InfoPacket tests read, next to the test DLL. -->
  <ItemGroup>
    <None Include="..\TestData\InfoPacket #1 - 0x40" Link="TestData\InfoPacket #1 - 0x40" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\InfoPacket #2 - 0x41" Link="TestData\InfoPacket #2 - 0x41" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\InfoPacket #3 - 0x43" Link="TestData\InfoPacket #3 - 0x43" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\InfoPacket #4 - 0x47" Link="TestData\InfoPacket #4 - 0x47" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\InfoPacket #5 - 0x54" Link="TestData\InfoPacket #5 - 0x54" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\TestData\InfoPacket #6 - 0x57" Link="TestData\InfoPacket #6 - 0x57" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

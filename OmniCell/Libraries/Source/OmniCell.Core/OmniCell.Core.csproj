<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>OmniCell.Core</AssemblyName>
    <RootNamespace>OmniCell.Core</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: the project has its own Properties\AssemblyInfo.cs,
         and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AOtomation.Messaging\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
    <ProjectReference Include="..\Cell.Core\Cell.Core.csproj" />
    <ProjectReference Include="..\Cell.Util\Cell.Util.csproj" />
    <ProjectReference Include="..\OmniCell.Enums\OmniCell.Enums.csproj" />
    <ProjectReference Include="..\OmniCell.Interfaces\OmniCell.Interfaces.csproj" />
    <ProjectReference Include="..\OmniCell.Database\OmniCell.Database.csproj" />
    <ProjectReference Include="..\OmniCell.ObjectManager\OmniCell.ObjectManager.csproj" />
    <ProjectReference Include="..\OmniCell.Stats\OmniCell.Stats.csproj" />
    <ProjectReference Include="..\Exceptions\OmniCell.Exceptions.csproj" />
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <ProjectReference Include="..\Translations\Translations.csproj" />
    <ProjectReference Include="..\Utility\Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.4" />
  </ItemGroup>

  <!-- MEF comes as a package on .NET. -->
  <ItemGroup>
    <PackageReference Include="System.ComponentModel.Composition" Version="10.0.0" />
  </ItemGroup>

</Project>

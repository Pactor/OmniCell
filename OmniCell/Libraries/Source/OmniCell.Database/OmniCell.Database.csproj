<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 for the engines as they are; net10.0 for the move to .NET 10. Each framework builds
         into its own subfolder of bin\<Configuration>. -->
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <AssemblyName>OmniCell.Database</AssemblyName>
    <RootNamespace>OmniCell.Database</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: the project has its own Properties\AssemblyInfo.cs,
         and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- .NET Framework only: these are part of .NET 10 or not used there. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OmniCell.Enums\OmniCell.Enums.csproj" />
    <ProjectReference Include="..\OmniCell.Interfaces\OmniCell.Interfaces.csproj" />
    <ProjectReference Include="..\Exceptions\OmniCell.Exceptions.csproj" />
    <ProjectReference Include="..\Utility\Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DatabaseTests\**" />
    <Compile Remove="Dao\BuddyListDao.cs" />
    <Compile Remove="Entities\DBBuddyListEntry.cs" />
    <Compile Include="..\..\..\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
  </ItemGroup>

  <!-- System.Data.SqlClient is not part of .NET 10. MSSQL was never usable here - every config
       uses MySql and the SQL is MySQL-only (backticks, ON DUPLICATE KEY UPDATE) - so the net10.0
       build leaves the connector out instead of taking on Microsoft.Data.SqlClient. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <Compile Remove="MSSqlConnector.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SqlTables\characterstimers.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\characters.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\charactersactivenanos.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\charactersmeshs.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\charactersuploadednanos.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\instanceditems.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\itemnames.sql" CopyToOutputDirectory="PreserveNewest" Condition="Exists('SqlTables\itemnames.sql')" />
    <Content Include="SqlTables\knubotscript.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\items.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\login.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobdroptable.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\moblootprofiles.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawns.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawnsactivenanos.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawnsinventory.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawnsmeshs.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawnsuploadednanos.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawnsweapons.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobcorpses.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobspawns_stats.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\quests.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\questobjectives.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\questitemrewards.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\questwire.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\questwireactions.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\questwirerewards.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\charactersquests.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\mobtemplate.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\organizations.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\proxydestinations.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\receivedmessages.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\shopinventorytemplates.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\staticdynels.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\stats.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\teleports.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\tradeskill.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\vendors.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="SqlTables\vendortemplate.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- NLog 2.1.0 has no .NET Standard or .NET build. The engines keep it on net48 until they
       move; the net10.0 build uses NLog 5, which has every API LogUtil calls. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="NLog" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="NLog" Version="5.3.4" />
  </ItemGroup>

</Project>

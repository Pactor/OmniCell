<Project Sdk="Microsoft.NET.Sdk">

  <!-- Command line for poking at the client's ResourceDatabase: record type counts, raw
       record dumps, icon surveys. Write its output outside the repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AssetDecoder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AssetDecoder\AssetDecoder.csproj" />
  </ItemGroup>

</Project>

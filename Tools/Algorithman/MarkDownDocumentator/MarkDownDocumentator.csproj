<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>MarkDownDocumentator</AssemblyName>
    <RootNamespace>MarkDownDocumentator</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: every project has its own Properties\AssemblyInfo.cs,
         outputs go exactly where they did, and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\..\..\OmniCell\Built\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\..\OmniCell\Built\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Data.DataSetExtensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\AOtomation.Messaging\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Core\OmniCell.Core.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Database\OmniCell.Database.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Enums\OmniCell.Enums.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Interfaces\OmniCell.Interfaces.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Stats\OmniCell.Stats.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\PlayfieldLoader\PlayfieldLoader.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\Utility\Utility.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Server\ZoneEngine\ZoneEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\OmniCell\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="App.config" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Extractor Serializer</AssemblyName>
    <RootNamespace>Extractor_Serializer</RootNamespace>
    <Platforms>AnyCPU</Platforms>
    <!-- Kept from the old project format: every project has its own Properties\AssemblyInfo.cs,
         outputs go exactly where they did, and only .cs and .resx files are picked up by default. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EmbeddedResourceUseDependentUponConvention>false</EmbeddedResourceUseDependentUponConvention>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>..\..\..\OmniCell\Built\Debug\</OutputPath>
    <DefineConstants>TRACE;DEBUG</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\..\OmniCell\Built\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- System.Drawing exports the client's icons. On .NET it is a package and works on Windows
       only, which is where the client this reads is installed. -->
  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\AOtomation.Messaging\SmokeLounge.AOtomation.Messaging\SmokeLounge.AOtomation.Messaging.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Core\OmniCell.Core.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Enums\OmniCell.Enums.csproj" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\OmniCell.Interfaces\OmniCell.Interfaces.csproj" />
    <PackageReference Include="MsgPack.Cli" Version="1.0.1" />
    <ProjectReference Include="..\..\..\OmniCell\Libraries\Source\Utility\Utility.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\..\OmniCell\SolutionAssemblyInfo.cs" Link="Properties\SolutionAssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="FunctionSets.cfg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Tyrbot's item relation rules, read by ItemRelationMatcher. -->
    <None Include="RelationRules\*.txt" LinkBase="RelationRules" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
